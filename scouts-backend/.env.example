PORT=3001

# Supabase Project URL (Lấy từ Project Settings -> Data API / API)
SUPABASE_URL=

# Supabase Anon / Publishable Key (Khóa công khai)
SUPABASE_ANON_KEY=

# Supabase Service Role Key (Khóa bí mật admin cho backend - bypass RLS)
# Lấy từ Project Settings -> API Keys / Data API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=
